# Local development. Copy to .env.local and fill in.
DATABRICKS_HOST=https://e2-demo-field-eng.cloud.databricks.com
DATABRICKS_TOKEN=<your-PAT-or-OAuth-access-token>

# MLflow tracing (UC-backed). Required for feedback / log_feedback to write —
# without MLFLOW_TRACING_SQL_WAREHOUSE_ID the Assessments API returns
# "SQL warehouse ID is required for accessing traces in UC tables".
MLFLOW_TRACKING_URI=databricks
MLFLOW_EXPERIMENT_NAME=/Users/jackson.reber@databricks.com/knowledge-assistant-demo-v3-local
MLFLOW_TRACING_SQL_WAREHOUSE_ID=4b9b953939869799
KA_TRACE_CATALOG=jreber_knowledge_assistant_demo
KA_TRACE_SCHEMA=audit
KA_TRACE_TABLE_PREFIX=ka_v3

# Local Lakebase (ka-v3 project — same one used by the deployed app).
# Leave PGUSER as your databricks email; deployed app uses the SP client_id.
# Leave any of these blank to disable chat persistence locally (agent still works).
ENDPOINT_NAME=projects/ka-v3/branches/production/endpoints/primary
PGHOST=ep-green-hat-d10d2olh.database.us-west-2.cloud.databricks.com
PGUSER=jackson.reber@databricks.com
PGDATABASE=databricks_postgres
PGPORT=5432
PGSSLMODE=require

# Where the agent config lives
AGENT_CONFIG_PATH=agent_config.yaml

ENV=development
